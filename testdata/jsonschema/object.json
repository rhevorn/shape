{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "minLength": 2,
      "type": "string"
    },
    "role": {
      "default": "user",
      "enum": [
        "user",
        "admin"
      ]
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "type": "array"
    }
  },
  "required": [
    "name"
  ],
  "type": "object"
}
